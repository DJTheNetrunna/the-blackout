# Local deployment paths. Copy to .env and edit locally.
KNOX_ROOT="$HOME/knox-nightmare"
PZ_SERVER_DIR="$HOME/knox-nightmare/server"
PZ_CACHE_DIR="$HOME/knox-nightmare/Zomboid"
STEAMCMD_DIR="$HOME/knox-nightmare/steamcmd"
BACKUP_DIR="$HOME/knox-nightmare/backups"
SERVER_NAME="KnoxNightmare"
MOD_PROFILE="core"

# Optional. Set to 1 if you want install/update scripts to ask SteamCMD to
# prefetch Workshop items. The PZ dedicated server also downloads configured
# WorkshopItems on launch.
PREFETCH_WORKSHOP=0
