# Dedicated deployment paths. Copy to .env and edit locally.
KNOX_ROOT="$HOME/knox-nightmare"
PZ_SERVER_DIR="$HOME/knox-nightmare/server"
PZ_CACHE_DIR="$HOME/knox-nightmare/Zomboid"
STEAMCMD_DIR="$HOME/knox-nightmare/steamcmd"
BACKUP_DIR="$HOME/knox-nightmare/backups"
SERVER_NAME="KnoxNightmare"
MOD_PROFILE="server"
PREFETCH_WORKSHOP=0

# Optional local overrides. Usually leave unset and let detect-local.sh locate
# the actual Steam library containing appmanifest_108600.acf.
# PZ_STEAMAPPS_DIR="$HOME/.local/share/Steam/steamapps"
# PZ_GAME_DIR="$PZ_STEAMAPPS_DIR/common/ProjectZomboid"
# PZ_WORKSHOP_DIR="$PZ_STEAMAPPS_DIR/workshop/content/108600"
# PZ_DATA_DIR="$HOME/Zomboid"
